{
  "name": "rejoltance",
  "private": true,
  "type": "module",
  "description": "RE:JOLTANCE — online lane card game. npm workspaces: packages/* (contracts, content, engine) and apps/* (server, web).",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node tools/setup.ts",
    "doctor": "node tools/doctor.ts",
    "dev": "node --env-file-if-exists=.env tools/dev.ts",
    "start": "npm run start -w @rejoltance/server",
    "build": "npm run build -w @rejoltance/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -b apps/web",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "check": "npm run spec:validate && npm run lint:md && npm run agents:check && npm run cards:check && npm run backlog:check && npm run docs:check",
    "spec:validate": "openspec validate --all --strict",
    "spec:list": "openspec list",
    "lint:md": "markdownlint-cli2",
    "agents": "node tools/agents/sync-agents.ts",
    "agents:check": "node tools/agents/sync-agents.ts --check",
    "cards": "node tools/content/extract-cards.ts",
    "cards:check": "node tools/content/extract-cards.ts --check",
    "backlog": "node tools/backlog/gen-jira-csv.ts",
    "backlog:check": "node tools/backlog/gen-jira-csv.ts --check",
    "docs:check": "node tools/confluence/sync-confluence.ts --check",
    "docs:export": "node tools/confluence/sync-confluence.ts --export",
    "docs:publish": "node --env-file-if-exists=.env tools/confluence/sync-confluence.ts --publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.15.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.20.0",
    "smol-toml": "^1.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
