root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_readonly_field = true:warning
# Kernel must stay deterministic: System.Random / DateTime.Now are banned in Kernel.csproj (BannedSymbols.txt)

# Analyzer tuning (CI builds with TreatWarningsAsErrors)
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

[tests/**.cs]
# Test names read as sentences: R04_drawing_from_empty_deck_deals_growing_fatigue_damage
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.{ps1,psm1,cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
