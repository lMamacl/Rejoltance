{
  "name": "@rejoltance/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative game server: Fastify (REST) + Socket.IO (matches). Validates intents and sends per-seat MatchView.",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts"
  },
  "dependencies": {
    "@rejoltance/content": "*",
    "@rejoltance/contracts": "*",
    "@rejoltance/engine": "*",
    "fastify": "^5.6.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
