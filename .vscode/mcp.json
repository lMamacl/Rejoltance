{
  "inputs": [
    {
      "type": "promptString",
      "id": "jira-pat",
      "description": "Jira PB Personal Access Token (Profile -> Personal Access Tokens)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "confluence-pat",
      "description": "Confluence PB Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "atlassian-pb": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.13", "mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://devtools.wi.pb.edu.pl/jira",
        "JIRA_PERSONAL_TOKEN": "${input:jira-pat}",
        "CONFLUENCE_URL": "https://devtools.wi.pb.edu.pl/confluence",
        "CONFLUENCE_PERSONAL_TOKEN": "${input:confluence-pat}",
        "READ_ONLY_MODE": "true"
      }
    }
  }
}
