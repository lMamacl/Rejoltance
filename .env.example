# Copy to .env (git-ignored) or set as user environment variables. Never commit real values.

# Jira / Confluence PB — Personal Access Token (Profile → Personal Access Tokens). Used only by the MCP server (.mcp.json).
JIRA_PERSONAL_TOKEN=
CONFLUENCE_PERSONAL_TOKEN=

# Disable OpenSpec anonymous usage stats
OPENSPEC_TELEMETRY=0

# .NET CLI telemetry off
DOTNET_CLI_TELEMETRY_OPTOUT=1
