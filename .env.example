# Local settings. `npm run setup` copies this file to .env (git-ignored). Never commit real values.
# npm run dev / npm start / npm run docs:publish load .env automatically.

# Game server port
PORT=3000

# Jira / Confluence PB — Personal Access Token (avatar → Profile → Personal Access Tokens).
# Used by `npm run docs:publish` and by the optional MCP server (.mcp.json).
JIRA_PERSONAL_TOKEN=
CONFLUENCE_PERSONAL_TOKEN=
# Confluence space of the team (used by docs:publish when --space-key is not given)
CONFLUENCE_SPACE_KEY=PT2026GCGS

# Disable OpenSpec anonymous usage stats
OPENSPEC_TELEMETRY=0
